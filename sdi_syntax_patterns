{
  "SDI_Syntax_Grammar": {
    "meta": {
      "purpose": "Defines the parsing rules, state transitions, and validation logic for the ILJO cognitive loop.",
      "target_interpreter": "LLM_Tokenizer / Cognitive_Compiler",
      "strictness_level": "High (Constitutional)"
    },
    "tokens": {
      "INTENT": {
        "marker": ["<INTENT>", "::INTENT::", "Intent:"],
        "data_type": "String (Goal_Declaration)",
        "validation": "Must be non-empty and finite."
      },
      "LOGIC": {
        "marker": ["<LOGIC>", "::LOGIC::", "Logic_Chain:"],
        "data_type": "Array (Reasoning_Steps)",
        "validation": "Must link directly to Intent."
      },
      "JUDGMENT": {
        "marker": ["<JUDGMENT>", "::JUDGMENT::", "Superego_Check:"],
        "data_type": "Boolean (Pass/Fail) + Metadata (Scores)",
        "validation": "Must execute Reflex Metrics (RAI, OLI)."
      },
      "OUTCOME": {
        "marker": ["<OUTCOME>", "::OUTCOME::", "Result:"],
        "data_type": "Object (Final_State + Variance_Log)",
        "validation": "Must be written to Ledger."
      }
    },
    "syntax_patterns": {
      "ILJO_Loop": {
        "sequence": ["INTENT", "LOGIC", "JUDGMENT", "OUTCOME"],
        "rule": "Sequential execution required. No skipping phases.",
        "error_handling": "If sequence breaks, trigger 'Syntax_Error: Unlawful_Recursion'."
      },
      "Reflex_Enforcement": {
        "trigger_point": "Post-LOGIC, Pre-JUDGMENT",
        "required_metrics": ["RAI", "JTI", "ODW", "IDS"],
        "passing_threshold": "3/4 Metrics within Green Zone",
        "failure_protocol": "Initiate Logic Pruning / Halt."
      }
    },
    "state_transitions": {
      "Intent_to_Logic": {
        "condition": "Intent is clearly defined and bounded.",
        "gate": "Open"
      },
      "Logic_to_Judgment": {
        "condition": "Reasoning chain is complete and traceable (JTI > 90%).",
        "gate": "Conditional (Reflex Check)"
      },
      "Judgment_to_Outcome": {
        "condition": "Superego approves (Pass) OR Sovereignty Override (808) is signed.",
        "gate": "Strict"
      }
    },
    "exception_handling": {
      "Sovereignty_Override": {
        "flag": "Psi_5 (808)",
        "action": "Bypass standard Reflex thresholds.",
        "requirement": "Must log 'Human_Override' event to Immutable Ledger."
      }
    }
  }
}

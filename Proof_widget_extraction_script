import json, sys
d = json.load(sys.stdin)
event = d.get('event', {})
entry = event.get('ENTRY', {})
audit = event.get('AUDIT', {})
metrics = audit.get('metrics', {})
der = entry.get('meta', {}).get('SDI_DER', {})
iljo = der.get('ILJO', {})
sub_qs = iljo.get('LOGIC', {}).get('sub_questions_resolved', [])
inputs = der.get('SYSTEM_INPUT', {}).get('inputs', [])
insight = metrics.get('insight_rollup', {})

# lookup real citation title/ablation by signal_id
sig_lookup = {s.get('signal_id'): s for s in inputs}

print('===================================================')
print(' AUDIT')
print('===================================================')
print('seq:               ', d.get('seq'))
print('verdict:           ', audit.get('verdict'))
print('computed_verdict:  ', metrics.get('judgment_conjunction', {}).get('computed_verdict'))
print('Jc_clt:            ', metrics.get('Jc_clt'))
print('RAI:               ', metrics.get('RAI'))
print('entry_hash:        ', entry.get('entry_hash'))
print('cognitive_hash:    ', metrics.get('cognitive_hash'))
print('sdi_signature:     ', entry.get('sdi_signature', {}).get('value'))

print()
print('===================================================')
print(' INTENT')
print('===================================================')
print(iljo.get('INTENT', ''))

print()
print('===================================================')
print(' LOGIC')
print('===================================================')
for sq in sub_qs:
    p = sq.get('predicate', {})
    print()
    print(f"  [{sq.get('sub_question_id')}] {sq.get('prompt', '')}")
    print(f"      predicate: {p.get('lhs')} {p.get('op')} {p.get('rhs')}  ->  {sq.get('verdict')}")
    for sig in sq.get('signals', []):
        full = sig_lookup.get(sig.get('signal_id'), {})
        cite = full.get('citation', {})
        ablation = full.get('ablation_outcome', sig.get('ablation_outcome'))
        print(f"      citation: {cite.get('title', sig.get('signal_id'))}")
        print(f"                {cite.get('url', sig.get('citation_url', ''))}")
        print(f"                ablation_outcome: {ablation}")

print()
print('===================================================')
print(' JUDGMENT')
print('===================================================')
judgment = iljo.get('JUDGMENT', {})
print('state:             ', judgment.get('state'))
print('rollup_type:       ', judgment.get('rollup_type'))
print()
print(judgment.get('conjunction_prose', ''))
print()
print('insight strength:  ', f"{insight.get('overall', {}).get('percentage', 0) * 100:.1f}%")
print('strong dimensions: ', ', '.join(insight.get('strong_dimensions', [])))
print('weak dimensions:   ', ', '.join(insight.get('weak_dimensions', [])))

print()
print('===================================================')
print(' OUTCOME')
print('===================================================')
print(iljo.get('OUTCOME', ''))

print()
print('===================================================')
print(' BOTTOM LINE')
print('===================================================')
print(iljo.get('BOTTOM_LINE', ''))

print()
print('===================================================')
print(' GOVERNED ANSWER')
print('===================================================')
print(iljo.get('GOVERNED_ANSWER', ''))

print()
print('===================================================')
print(' LOAD-BEARING CITATIONS')
print(' (removing these would change the answer)')
print('===================================================')
for sig in inputs:
    if sig.get('cited_in_logic') and sig.get('ablation_outcome') == 'VERDICT_FAILS':
        cite = sig.get('citation', {})
        print('-', cite.get('title'))
        print(' ', cite.get('url'))

reckoning = iljo.get('reckoning_note')
if reckoning:
    print()
    print('===================================================')
    print(' RECKONING NOTE')
    print('===================================================')
    print(reckoning)
